# Copy to .env and fill in. .env is gitignored — never commit real credentials.

APP_NAME="Task API"
DEBUG=false

# ── MongoDB ──────────────────────────────────────────────────────────────
# The whole credential lives in the URI, so an Atlas string pastes in as-is:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# A password with @ / : or ? in it must be percent-encoded.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="taskapi"
MONGODB_COLLECTION="tasks"

# How long to wait for a server before failing, in milliseconds.
MONGODB_TIMEOUT_MS=5000
